name: Build and test

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
      - name: Build plugin jar
        run: |
          chmod +x gradlew
          ./gradlew build --stacktrace
      - name: Upload jar
        uses: actions/upload-artifact@v4
        with:
          name: logiclib-paper-jar
          path: build/libs/*.jar

  # Starts a real Paper server on every target version with LogicLib and checks the log.
  paper-test:
    needs: build
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - { mc: "1.12.2", java: 8 }
          - { mc: "1.16.5", java: 11 }
          - { mc: "1.18.2", java: 17 }
          - { mc: "1.19.2", java: 17 }
          - { mc: "1.20.1", java: 17 }
          - { mc: "1.21.1", java: 21 }
          - { mc: "1.21.11", java: 21 }
          - { mc: "26.1.2", java: 25 }
          - { mc: "26.2", java: 25 }
          - { mc: "26.3", java: 25 }
    name: paper-test (${{ matrix.mc }})
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ matrix.java }}
      - uses: actions/download-artifact@v4
        with:
          name: logiclib-paper-jar
          path: jars
      - name: Download Paper ${{ matrix.mc }}
        run: |
          mkdir -p server/plugins && cd server
          bash ../ci/get-paper.sh "${{ matrix.mc }}"
          find ../jars -name "logiclib-paper-*.jar" ! -name "*-sources.jar" -exec cp {} plugins/ \;
          ls plugins
      - name: Start server and check LogicLib
        run: |
          chmod +x ci/server-test.sh
          ci/server-test.sh server "LogicLib for Paper .* running on Minecraft" -- java -Xmx1500M -jar paper.jar nogui

  # After every test passes: print the jar's checksum and base64 so Claude
  # (whose workspace can't download artifacts) can take the exact tested jar.
  export:
    needs: [paper-test]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: logiclib-paper-jar
          path: jars
      - name: Print tested jar
        run: |
          for f in $(find jars -name '*.jar' ! -name '*-sources.jar' ! -name '*-javadoc.jar' | sort); do
            echo "JAR $(basename $f) $(stat -c%s $f) $(sha256sum $f | cut -d' ' -f1)"
            echo "B64BEGIN $(basename $f)"; base64 -w 4000 $f; echo "B64END"
          done
